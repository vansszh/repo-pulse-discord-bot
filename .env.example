# --- Discord -----------------------------------------------------------------

# Get this from https://discord.com/developers/applications → your app → Bot
DISCORD_BOT_TOKEN=your-discord-bot-token-here

# Optional: comma-separated Discord guild (server) IDs to sync slash commands to
# instantly during development. Leave blank to sync globally (takes up to 1 hour).
DISCORD_DEV_GUILD_IDS=

# --- GitHub ------------------------------------------------------------------

# A strong random string. MUST match the "Secret" set on your GitHub webhook.
# Example: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=change-me-to-a-random-string

# --- Webhook server ----------------------------------------------------------

WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8000

# --- Storage -----------------------------------------------------------------

DATABASE_PATH=./data/repopulse.db

# --- Review reminders --------------------------------------------------------

# Hours of inactivity before a PR gets a reminder nudge
REVIEW_REMINDER_HOURS=24

# How often (minutes) the background task scans for stale PRs
REVIEW_REMINDER_INTERVAL_MINUTES=60

# --- Logging -----------------------------------------------------------------

LOG_LEVEL=INFO
